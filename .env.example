# Copy to .env and fill in real values. .env is gitignored (secrets).
# These are the only variables the sub-agent endpoint (POST /proxy/chat/batch) needs.

# --- OpenWebUI connection ---
# Note: the caller bearer and the sub-agent tools key are NOT env vars — they
# travel per request in the Authorization and X-Subagent-Tools-Key headers.
# Base URL of the OpenWebUI instance.
# IMPORTANT (Docker): inside a container this must NOT be "localhost" (that
# points at the container itself). Use host.docker.internal or a service name
# on a shared Docker network, e.g. http://host.docker.internal:3000
OPENWEBUI_BASE_URL="http://localhost:3000"
# Port the container listens on. REQUIRED: the app will not start without it.
# Change it if 8000 is busy locally. On clouds, define it in the platform's
# env settings with the port you want (or the one the platform mandates).
PORT="8000"
# Maximum number of sub-agents run concurrently by POST /proxy/chat/batch.
# Optional: defaults to 5. Trailing tasks beyond this limit are dropped and
# reported in the response `info` field. Must be a positive integer.
MAX_BATCH_SUBAGENTS="5"
# When true, each sub-agent chat created via POST /proxy/chat/batch is archived
# right after its generation finishes (done:true), so it disappears from the
# main list but remains continuable via its chat_id. Per-request body field
# `archive` overrides this default. Optional: defaults to true.
PROXY_AUTO_ARCHIVE="true"
# Guard against LLM tool-call loops: max sub_agents calls per parent message_id.
# When exceeded, the proxy returns a loop-guard response so the model stops
# retrying. Optional: defaults to 5. Must be a positive integer.
MAX_SUBAGENT_CALLS_PER_MESSAGE="5"
