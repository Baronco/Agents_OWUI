# Copy to .env and fill in real values. .env is gitignored (secrets).

# --- OpenWebUI connection ---
OWUI_API_KEY="REPLACE-WITH-OWUI-API-KEY"
# Note (spec 017): the sub-agent tools key is NOT an env var — it travels per
# request in the X-Subagent-Tools-Key header (set on the API connection).
# Base URL of the OpenWebUI instance.
# IMPORTANT (Docker): inside a container this must NOT be "localhost" (that
# points at the container itself). Use host.docker.internal or a service name
# on a shared Docker network, e.g. http://host.docker.internal:3000
OPENWEBUI_BASE_URL="http://localhost:3000"

# --- Secrets ---
# REQUIRED. HMAC secret used to derive each provisioned user's password.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Changing this invalidates all existing provisioned user accounts.
USER_PASSWORD_SECRET="REPLACE-WITH-32-BYTE-HEX-SECRET"

# --- Markdown generation endpoint (spec 015, ported from GenFilesMCP) ---
# Base URL of the Open WebUI instance used for user-id lookup, upload, and
# knowledge filing. Point at the SAME instance as OPENWEBUI_BASE_URL.
OWUI_URL="http://localhost:3000"
# Whether to file the generated .md into a knowledge collection.
ENABLE_CREATE_KNOWLEDGE="true"
# Name of the knowledge collection that receives generated files.
KNOWLEDGE_COLLECTION_NAME="My Generated Files"
# Whether the endpoint returns the HTML download-page or the structured result.
# The /learn handler forces this to False (always raw structured result).
DOWNLOAD_HTML_BUTTON="false"

# --- Token cache ---
# Treat a cached token as expired this many seconds before its real expiry
# (must be < the OWUI JWT lifetime, typically 3600s).
TOKEN_EXPIRY_SECONDS="3500"

# --- Data paths ---
# Tenant config file. Default (local): ./config/tenants.json
# In Docker, point this at the mounted volume, e.g. /data/config/tenants.json
TENANTS_CONFIG_PATH="./config/tenants.json"
# Directory holding per-user token files (one JSON per client_phone+tenant).
# Default (local): ./users  — In Docker: /data/users
USERS_DIR="./users"
